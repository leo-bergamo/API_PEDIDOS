# Configurações da aplicação
APP_NAME=API Pedidos
APP_ENV=development

# Banco de dados PostgreSQL
POSTGRES_USER=pedidos_user
POSTGRES_PASSWORD=pedidos_pass
POSTGRES_DB=pedidos_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL de conexão montada a partir das variáveis acima (usada pela aplicação)
DATABASE_URL=postgresql+psycopg2://pedidos_user:pedidos_pass@postgres:5432/pedidos_db
